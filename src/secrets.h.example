// Copy this file to src/secrets.h and fill in your WiFi credentials.
// src/secrets.h is gitignored. If secrets.h is absent or the SSID is empty,
// the firmware runs offline: no NTP sync, schedule falls back to a safe hold.
#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID     ""
#define WIFI_PASSWORD ""

// Optional: coordinates for the open-meteo outdoor-temperature feed.
// Leave 0.0/0.0 to disable weather fetching entirely.
#define WEATHER_LATITUDE  0.0
#define WEATHER_LONGITUDE 0.0

// Optional: MQTT broker (empty host = MQTT disabled). Enables the Home
// Assistant climate entity (auto-discovery) and Zigbee2MQTT sensor ingestion.
#define MQTT_HOST ""
#define MQTT_PORT 1883
#define MQTT_USER ""
#define MQTT_PASS ""

// Optional: Zigbee2MQTT topics of the Aqara probes (empty = not used).
// Payloads are expected in Z2M's default units (temperature in Celsius).
// e.g. "zigbee2mqtt/living_room_sensor" and "zigbee2mqtt/outdoor_sensor"
#define Z2M_INDOOR_TOPIC  ""
#define Z2M_OUTDOOR_TOPIC ""

// Optional: over-the-air update password (empty = OTA disabled).
#define OTA_PASSWORD ""

#endif // SECRETS_H
