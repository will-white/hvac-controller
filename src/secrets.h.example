// Copy this file to src/secrets.h and fill in your WiFi credentials.
// src/secrets.h is gitignored. A build with WIFI_SSID set writes ALL of these
// values to the thermostat's NVS at boot; builds without it (including the
// ones CI publishes for WiFi updates) keep using what NVS holds. So flash one
// build with your secrets.h over USB, and later WiFi updates stay online.
// With no credentials anywhere the firmware runs offline: no NTP sync, and the
// schedule falls back to a safe hold. The console `net set` edits NVS too.
#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID     ""
#define WIFI_PASSWORD ""

// Optional: coordinates for the open-meteo outdoor-temperature feed.
// Leave 0.0/0.0 to disable weather fetching entirely.
#define WEATHER_LATITUDE  0.0
#define WEATHER_LONGITUDE 0.0

// Optional: MQTT broker (empty host = MQTT disabled). Enables the Home
// Assistant climate entity (auto-discovery) and Zigbee2MQTT sensor ingestion.
#define MQTT_HOST ""
#define MQTT_PORT 1883
#define MQTT_USER ""
#define MQTT_PASS ""

// Optional: Zigbee2MQTT topics of the Aqara probes (empty = not used).
// Payloads are expected in Z2M's default units (temperature in Celsius).
// e.g. "zigbee2mqtt/living_room_sensor" and "zigbee2mqtt/outdoor_sensor"
#define Z2M_INDOOR_TOPIC  ""
#define Z2M_OUTDOOR_TOPIC ""

// Optional: password for WiFi updates by upload (dashboard /update, user
// "admin") and ArduinoOTA (empty = both disabled). The automatic pull from
// the GitHub release channel does not need it.
#define OTA_PASSWORD ""

#endif // SECRETS_H
